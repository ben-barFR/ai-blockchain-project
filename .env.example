# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres URI for `npm run init:supabase` (Dashboard → Database → URI).
# If omitted, the script uses a linked Supabase CLI project (`npx supabase link`).
DATABASE_URL=

# Google Gemini
GEMINI_API_KEY=

# Ethereum Sepolia / certificates
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CERTIFICATE_CONTRACT=
CERT_MINTER_PRIVATE_KEY=

# Comma-separated emails that can review issuers at /admin
ADMIN_EMAILS=
